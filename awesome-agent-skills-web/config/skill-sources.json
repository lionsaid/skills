[
  {
    "id": "lionsaid-curated-local",
    "label": "LionSaid curated list",
    "enabled": true,
    "transport": "local",
    "parser": "awesome-markdown",
    "path": "../README.md",
    "sourceType": "curated-readme",
    "trustLevel": "curated",
    "riskFlags": []
  },
  {
    "id": "github-curated-mirror",
    "label": "GitHub curated mirror",
    "enabled": true,
    "transport": "remote",
    "parser": "awesome-markdown",
    "url": "https://raw.githubusercontent.com/VoltAgent/awesome-agent-skills/main/README.md",
    "sourceType": "github-readme",
    "trustLevel": "curated",
    "riskFlags": []
  },
  {
    "id": "officialskills-home",
    "label": "Official skills index",
    "enabled": true,
    "transport": "remote",
    "parser": "remote-html",
    "url": "https://officialskills.sh",
    "linkPattern": "^/([^/]+)/skills/([^/]+)$",
    "sectionTitle": "Official skills",
    "kind": "official",
    "descriptionFallback": "Indexed from an official skills site",
    "descriptionPattern": "class=\\\"text-\\[12px\\] sm:text-\\[14px\\] truncate flex-1 min-w-0\\\"[^>]*>(.*?)</p>",
    "sourceType": "official-site",
    "trustLevel": "official",
    "riskFlags": []
  },
  {
    "id": "clawhub-home",
    "label": "ClawHub marketplace (Convex query)",
    "enabled": true,
    "transport": "remote",
    "parser": "marketplace-api",
    "url": "https://wry-manatee-359.convex.cloud/api/query",
    "sectionTitle": "Community marketplace",
    "kind": "community",
    "descriptionFallback": "Indexed from a community marketplace",
    "maxPages": 25,
    "pageSize": 40,
    "sourceType": "marketplace",
    "trustLevel": "untrusted",
    "riskFlags": [
      "community-marketplace",
      "requires-security-review"
    ]
  },
  {
    "id": "github-repo-expansion",
    "label": "GitHub repository discovery",
    "enabled": true,
    "transport": "remote",
    "parser": "github-repo-expansion",
    "url": "https://github.com",
    "sectionTitle": "GitHub discovery",
    "kind": "community",
    "descriptionFallback": "Discovered from a public GitHub repository",
    "maxRepositories": 60,
    "sourceType": "github-discovery",
    "trustLevel": "untrusted",
    "riskFlags": [
      "github-discovery",
      "requires-security-review"
    ]
  }
]
