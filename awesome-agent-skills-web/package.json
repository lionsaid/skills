{
  "name": "lionsaid-skills-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "generate:data": "node scripts/generate-skills-data.mjs && npm run generate:repo-stats && npm run refresh:github-cache && npm run refresh:github-summaries && node scripts/generate-skills-data.mjs && npm run generate:repo-stats && npm run validate:roles && npm run validate:high-star && npm run validate:github-summaries && npm run audit:roles && npm run audit:recommendations",
    "generate:repo-stats": "node scripts/generate-repo-stats.mjs && npm run generate:high-star-repos",
    "generate:high-star-repos": "node scripts/generate-high-star-github-repos.mjs",
    "validate:roles": "node scripts/validate-roles.mjs",
    "validate:high-star": "node scripts/validate-high-star-skills.mjs",
    "validate:github-summaries": "node scripts/validate-github-skill-summaries.mjs",
    "audit:roles": "node scripts/audit-roles.mjs",
    "audit:recommendations": "node scripts/audit-recommendation-quality.mjs",
    "refresh:github-cache": "node scripts/refresh-github-repo-expansion-cache.mjs",
    "refresh:github-summaries": "node scripts/enrich-github-skill-summaries.mjs && node scripts/fill-github-collection-descriptions.mjs",
    "refresh:publisher-logos": "node scripts/refresh-publisher-logos.mjs",
    "refresh:all": "npm run generate:data && npm run generate:repo-stats && npm run refresh:publisher-logos",
    "dev": "next dev",
    "build": "npm run clean:build && npm run validate:roles && next build",
    "start": "next start",
    "serve:static": "python3 -m http.server",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:dev-static": "node scripts/check-dev-static-visibility.mjs"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
